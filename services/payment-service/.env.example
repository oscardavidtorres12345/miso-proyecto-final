APP_NAME=TravelHub Payment Service
APP_VERSION=0.1.0
APP_ENV=development

# Database Configuration
DATABASE_URL=sqlite:///./payment.db
# DATABASE_URL=postgresql://payment_user:payment_pass@localhost:5432/payment_db

# Stripe Configuration
# Get these from: https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_YOUR_SECRET_KEY_HERE
STRIPE_PUBLISHABLE_KEY=pk_test_YOUR_PUBLISHABLE_KEY_HERE

# Get this from: https://dashboard.stripe.com/test/webhooks
STRIPE_WEBHOOK_SECRET=whsec_YOUR_WEBHOOK_SECRET_HERE

# Service URLs
BOOKING_SERVICE_URL=http://localhost:8004
INVENTORY_SERVICE_URL=http://localhost:8006
