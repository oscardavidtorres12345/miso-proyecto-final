APP_NAME=TravelHub Service
APP_VERSION=0.1.0
APP_ENV=development

# Base de datos principal (escritura)
DATABASE_URL=postgresql+asyncpg://travelhub:travelhub@localhost:5432/search_db

# Réplica de lectura (HU023 PF-281) — si no se configura, usa DATABASE_URL
READ_REPLICA_URL=postgresql+asyncpg://travelhub:travelhub@localhost:5432/search_db

# Redis — cache-aside (HU023)
REDIS_URL=redis://localhost:6379
CACHE_TTL_SECONDS=300

