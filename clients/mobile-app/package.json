{
  "name": "mobile-app",
  "version": "0.0.1",
  "private": true,
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "start:android": "expo run:android",
    "start:ios": "expo run:ios",
    "lint": "eslint .",
    "test:unit": "jest --testPathPattern='tests/unit' --watchAll=false --forceExit",
    "test:unit:coverage": "jest --testPathPattern='tests/unit' --coverage --watchAll=false --forceExit --coverageProvider=v8",
    "test:unit:ci": "jest --testPathPattern='tests/unit' --coverage --watchAll=false --forceExit --runInBand --detectOpenHandles --coverageProvider=v8",
    "test:accessibility": "jest --testPathPattern='tests/accessibility' --watchAll=false --forceExit",
    "test:accessibility:ci": "jest --testPathPattern='tests/accessibility' --watchAll=false --forceExit --runInBand --detectOpenHandles",
    "test:accessibility:coverage": "node scripts/check-accessibility-coverage.js",
    "test:e2e:android": "start-server-and-test start http://localhost:8081/status 'detox test -c android.emu.debug'",
    "test:e2e:ios": "start-server-and-test start http://localhost:8081/status 'detox test -c ios.sim.debug'",
    "test:e2e:build:android": "detox build -c android.emu.debug",
    "test:e2e:build:ios": "detox build -c ios.sim.debug",
    "clean": "rm -rf node_modules && npm cache clean --force && npm install",
    "clean:build": "rm -rf ios/build android/app/build artifacts"
  },
  "dependencies": {
    "@expo-google-fonts/quicksand": "^0.4.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~54.0.0",
    "expo-camera": "^55.0.18",
    "expo-font": "^55.0.6",
    "expo-navigation-bar": "^55.0.12",
    "expo-notifications": "~0.32.17",
    "i18next": "^25.10.10",
    "lucide-react-native": "^1.11.0",
    "react": "19.1.0",
    "react-i18next": "^16.6.6",
    "react-native": "0.81.5",
    "react-native-calendars": "^1.1314.0",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-svg": "15.12.1"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.0.0",
    "@react-native-community/cli-platform-android": "20.0.0",
    "@react-native-community/cli-platform-ios": "20.0.0",
    "@react-native/babel-preset": "0.81.5",
    "@react-native/eslint-config": "0.81.5",
    "@react-native/metro-config": "0.81.5",
    "@react-native/typescript-config": "0.81.5",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.13",
    "@types/react": "~19.1.10",
    "@types/react-test-renderer": "^19.1.0",
    "babel-preset-expo": "~54.0.10",
    "detox": "^20.47.0",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "prettier": "2.8.8",
    "react-native-svg-transformer": "^1.5.3",
    "react-test-renderer": "19.1.0",
    "start-server-and-test": "^2.1.5",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=20.19.4"
  }
}
