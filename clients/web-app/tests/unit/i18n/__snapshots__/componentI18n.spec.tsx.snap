exports[`PopularDestinationsSection i18n > snapshot: en-US 1`] = `
<div>
  <section
    class="destinations page-section"
  >
    <div
      class="page-container"
    >
      <p
        class="section-label"
      >
        Popular destinations
      </p>
      <h2
        class="section-heading"
      >
        Discover popular destinations
      </h2>
    </div>
    <div
      class="page-container destinations__scroll-wrapper"
    >
      <div
        class="destinations__cards"
      >
        <div
          class="destination-card"
        >
          <img
            alt="Cartagena"
            class="destination-card__image"
            src="https://wallpapercave.com/wp/wp3350882.jpg"
          />
          <p
            class="destination-card__city"
          >
            Cartagena
          </p>
        </div>
        <div
          class="destination-card"
        >
          <img
            alt="Medellín"
            class="destination-card__image"
            src="https://t4.ftcdn.net/jpg/03/57/67/49/360_F_357674904_aEjvlRkZ8ZqJa0vSibQQbNiYUuEPv6MM.jpg"
          />
          <p
            class="destination-card__city"
          >
            Medellín
          </p>
        </div>
        <div
          class="destination-card"
        >
          <img
            alt="Bogotá"
            class="destination-card__image"
            src="https://e0.pxfuel.com/wallpapers/588/561/desktop-wallpaper-bogota-bogota-bogota-background-and-bogota-de-noche-bogota.jpg"
          />
          <p
            class="destination-card__city"
          >
            Bogotá
          </p>
        </div>
        <div
          class="destination-card"
        >
          <img
            alt="Santa Marta"
            class="destination-card__image"
            src="https://e1.pxfuel.com/desktop-wallpaper/562/944/desktop-wallpaper-santa-marta.jpg"
          />
          <p
            class="destination-card__city"
          >
            Santa Marta
          </p>
        </div>
      </div>
    </div>
  </section>
</div>
`;

